install.packages("haven")
library(dplyr)
library(haven)
library(tidyverse)
setwd("./01_intro_data_science/DataScienceProject/")
getwd()
setwd("../01_intro_data_science/DataScienceProject/")
rm(list = ls())
#### Preliminary
# Libraries
library(arrow)
library(ggplot2)
library(ezids)
getwd()
setwd("..")
#### Reading the parquet file
food <- read_parquet("proc_data/demo_foods.parquet")
str(food)
# Quick look at the dataset: Summary
xkablesummary(food)
str(food)
xkablesummary(food[c("RIAGENDR", "RIDAGEYR", "RIDRETH3", "DMDEDUC2", "DMDMARTZ","DMDHHSIZ", "INDFMPIR")])
library(labelled)
library(labelled)
var_label(demographics$RIDAGEYR)
var_label(food$RIDAGEYR)
food %>%
summarise(across(where(is.numeric), ~ mean(.x, na.rm = TRUE))) %>%
rename_with(~ sapply(demographics[c("RIAGENDR", "RIDAGEYR", "RIDRETH3", "DMDEDUC2", "DMDMARTZ","DMDHHSIZ", "INDFMPIR")], var_label))
food %>%
select(RIAGENDR, RIDAGEYR, RIDRETH3, DMDEDUC2, DMDMARTZ,DMDHHSIZ, INDFMPIR) %>%
tbl_summary(
label = everything() ~ label,  # use variable labels automatically
statistic = all_continuous() ~ "{mean} ({sd})"
)
library(gtsummary)
library(gtsummary)
food %>%
select(RIAGENDR, RIDAGEYR, RIDRETH3, DMDEDUC2, DMDMARTZ,DMDHHSIZ, INDFMPIR) %>%
tbl_summary(
label = everything() ~ label,  # use variable labels automatically
statistic = all_continuous() ~ "{mean} ({sd})"
)
food <- food %>%
set_variable_labels(
RIAGENDR = "Gender",
RIDAGEYR = "Age (years)",
RIDRETH3 = "Race/ethnicity",
DMDEDUC2 = "Education level",
DMDMARTZ = "Marital status",
DMDHHSIZ = "Household size",
INDFMPIR = "Poverty income ratio"
)
food %>%
select(RIAGENDR, RIDAGEYR, RIDRETH3, DMDEDUC2, DMDMARTZ,DMDHHSIZ, INDFMPIR) %>%
tbl_summary(
label = everything() ~ label,  # use variable labels automatically
statistic = all_continuous() ~ "{mean} ({sd})"
)
food2 <- food %>%
mutate(across(where(is.labelled), to_factor))
food2 %>%
select(RIAGENDR, RIDAGEYR, RIDRETH3, DMDEDUC2, DMDMARTZ, DMDHHSIZ, INDFMPIR) %>%
tbl_summary(
type = list(
RIAGENDR ~ "categorical",
RIDRETH3 ~ "categorical",
DMDEDUC2 ~ "categorical",
DMDMARTZ ~ "categorical"
),
statistic = all_continuous() ~ "{mean} ({sd})"
) %>%
bold_labels()
food2 %>%
select(RIAGENDR, RIDAGEYR, RIDRETH3, DMDEDUC2, DMDMARTZ, DMDHHSIZ, INDFMPIR) %>%
tbl_summary(
type = list(
RIAGENDR ~ "categorical",
RIDRETH3 ~ "categorical",
DMDEDUC2 ~ "categorical",
DMDMARTZ ~ "categorical"
),
statistic = all_continuous() ~ "{mean} ({sd})",
missing = "ifany"   # <--- shows N (and %) of missing values
) %>%
bold_labels()
food2 %>%
select(RIAGENDR, RIDAGEYR, RIDRETH3, DMDEDUC2, DMDMARTZ, DMDHHSIZ, INDFMPIR) %>%
tbl_summary(
