write.xlsx(tbl2, "output/EDA_demogcontinuous_summary.xlsx")
ggplot(food, aes(DR1IKCAL_sum)) +
geom_histogram(breaks=seq(0, 10000, by = 500), fill = "skyblue", color = "black", alpha = 0.9) +
labs(title = "Distribution of Daily Calorie Intake",
x = "Total Calories (kcal)",
y = "Frequency")
hkcal <- ggplot(food, aes(DR1IKCAL_sum)) +
geom_histogram(breaks=seq(0, 10000, by = 500), fill = "skyblue", color = "black", alpha = 0.9) +
labs(title = "Distribution of Daily Calorie Intake",
x = "Total Calories (kcal)",
y = "Frequency")
ggsave("output/EDA_hist_kcal.png", plot = hkcal, width = 8, height = 6, dpi = 300)
ggplot(food, aes(DR1IKCAL_sum)) +
geom_histogram(breaks=seq(0, 10000, by = 500), fill = "gold", color = "black", alpha = 0.9) +
labs(title = "Distribution of Daily Calorie Intake",
x = "Total Calories (kcal)",
y = "Frequency")
ggplot(food, aes(DR1IKCAL_sum)) +
geom_histogram(
breaks = seq(0, 10000, by = 500),
fill = "gold",
color = "brown",
alpha = 0.9
) +
labs(
title = "Distribution of Daily Calorie Intake",
x = "Total Calories (kcal)",
y = "Frequency"
) +
theme(
# Background colors
plot.background = element_rect(fill = "beige", color = NA),   # outside area
panel.background = element_rect(fill = "beige", color = NA),  # plot area
panel.grid.major = element_line(color = "white"),             # optional: lighten grid
panel.grid.minor = element_blank(),
# Font sizes
plot.title = element_text(size = 18, face = "bold", hjust = 0.5),  # title
axis.title = element_text(size = 14, face = "bold"),               # axis titles
axis.text = element_text(size = 12)                                # axis labels
)
ggplot(food, aes(DR1IKCAL_sum)) +
geom_histogram(
breaks = seq(0, 10000, by = 500),
fill = "bisque",
color = "bisque",
alpha = 0.9
) +
labs(
title = "Distribution of Daily Calorie Intake",
x = "Total Calories (kcal)",
y = "Frequency"
) +
theme(
