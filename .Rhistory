install.packages("haven")
library(dplyr)
library(haven)
library(tidyverse)
setwd("./01_intro_data_science/DataScienceProject/")
getwd()
setwd("../01_intro_data_science/DataScienceProject/")
rm(list = ls())
#### Preliminary
# Libraries
library(arrow)
library(ggplot2)
library(ezids)
library(labelled)
library(gtsummary)
#Set Working Directory as the DataScienceProject folder
getwd()
setwd("..")
#### Reading the parquet file
food <- read_parquet("proc_data/demo_foods.parquet")
str(food)
table(food[c("RIAGENDR", "RIDRETH3", "DMDEDUC2", "DMDMARTZ")])
table(food$RIAGENDR)
food %>%
select(RIAGENDR, RIDRETH3, DMDEDUC2, DMDMARTZ) %>%
tbl_summary(
type = list(
RIAGENDR ~ "categorical",
RIDRETH3 ~ "categorical",
DMDEDUC2 ~ "categorical",
DMDMARTZ ~ "categorical"
),
statistic = all_continuous() ~ "{mean} ({sd})",
missing = "ifany"   # <--- shows N (and %) of missing values
) %>%
bold_labels()
library(openxlsx)
library(openxlsx)
tbl <- food %>%
select(RIAGENDR, RIDRETH3, DMDEDUC2, DMDMARTZ) %>%
tbl_summary(
type = list(
RIAGENDR ~ "categorical",
RIDRETH3 ~ "categorical",
DMDEDUC2 ~ "categorical",
DMDMARTZ ~ "categorical"
),
statistic = all_continuous() ~ "{mean} ({sd})",
missing = "ifany"   # <--- shows N (and %) of missing values
) %>%
bold_labels()
tbl_df <- as_tibble(tbl, col_labels = TRUE)
write.xlsx(tbl_df, "output/EDA_categorical_demo.xlsx")
food %>%
select(RIDAGEYR, DMDHHSIZ, INDFMPIR) %>%
summarise(across(
everything(),
list(
mean  = ~ mean(.x, na.rm = TRUE),
sd    = ~ sd(.x, na.rm = TRUE),
min   = ~ min(.x, na.rm = TRUE),
max   = ~ max(.x, na.rm = TRUE),
n_na  = ~ sum(is.na(.x))
),
.names = "{.col}__{.fn}"
)) %>%
pivot_longer(
everything(),
names_to = c("variable", "stat"),
names_sep = "__",
values_to = "value"
) %>%
pivot_wider(
names_from = stat,
values_from = value
) %>%
# 3) Attach variable labels (if present)
mutate(label = sapply(variable, function(v) var_label(food[[v]]) %||% NA_character_)) %>%
relocate(variable, label) %>%
food %>%
select(RIDAGEYR, DMDHHSIZ, INDFMPIR) %>%
summarise(across(
everything(),
list(
mean  = ~ mean(.x, na.rm = TRUE),
sd    = ~ sd(.x, na.rm = TRUE),
min   = ~ min(.x, na.rm = TRUE),
max   = ~ max(.x, na.rm = TRUE),
n_na  = ~ sum(is.na(.x))
),
.names = "{.col}__{.fn}"
)) %>%
pivot_longer(
everything(),
names_to = c("variable", "stat"),
names_sep = "__",
values_to = "value"
) %>%
pivot_wider(
names_from = stat,
values_from = value
) %>%
# 3) Attach variable labels (if present)
mutate(label = sapply(variable, function(v) var_label(food[[v]]) %||% NA_character_)) %>%
relocate(variable, label) %>%
# (optional) Round for neatness
mutate(across(c(mean, sd, min, max), ~ round(.x, 2)))
