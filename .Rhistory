install.packages("haven")
library(dplyr)
library(haven)
library(tidyverse)
setwd("./01_intro_data_science/DataScienceProject/")
getwd()
setwd("../01_intro_data_science/DataScienceProject/")
rm(list = ls())
#### Preliminary
# Libraries
library(arrow)
library(ggplot2)
library(ezids)
library(labelled)
library(gtsummary)
library(openxlsx)
library(dplyr)
library(tidyr)
library(vctrs)
library(tibble)
library(knitr)
library(broom)
#Set Working Directory as the DataScienceProject folder
getwd()
setwd("..")
#### Reading the parquet file
food <- read_parquet("proc_data/demo_foods.parquet")
#As percentage
food$INDFMPIR <- food$INDFMPIR * 100
hsug_income_scatter <- ggplot(food, aes(x = INDFMPIR, y = DR1ISUGR_sum)) +
geom_point(
color = "chocolate4",
fill = "chocolate",
alpha = 0.6,
shape = 21,
size = 3,
na.rm = TRUE
) +
labs(
title = "Scatter Plot of Daily Sugar Intake vs. Family Income (% of Poverty)",
x = "Family Income as % of Poverty Level (INDFMPIR)",
y = "Total Sugar Intake (grams)"
) +
theme(
# Background colors
plot.background = element_rect(fill = "antiquewhite", color = NA),   # outside area
panel.background = element_rect(fill = "antiquewhite", color = NA),  # plot area
panel.grid.major = element_line(color = "white"),                    # light grid
panel.grid.minor = element_blank(),
# Font sizes
plot.title = element_text(size = 18, face = "bold", hjust = 0.5),
axis.title = element_text(size = 14, face = "bold"),
axis.text  = element_text(size = 12)
)
ggsave("output/EDA_scatter_sugar_income.png", plot = hsug_income_scatter, width = 8, height = 6, dpi = 300)
hsug_income_scatter
