spearman_test_result
g22=ggscatter(
data = food,
x = "incomepovline",
y = "log_sugar",
add = "loess",            # <-- LOWESS instead of reg.line
conf.int = TRUE,          # confidence band for loess
cor.method = "spearman",
xlab = "Ratio of Income to Poverty Line",
ylab = "Logarithm of Sugar Intake",
title = "Scatter Plot with Spearman Correlation",
caption="Note: red line represents the LOESS locally weighted scatterplot smoother.\nCalculations using survey weights",
color = "#4DBBD5",        # point color
alpha = 0.5,              # (optional) match earlier transparency
add.params = list(
color = "#E64B35",      # LOWESS line color
size = 1
)
) +
stat_cor(
method = "spearman",
label.x = min(food$incomepovline, na.rm = TRUE),
label.y = max(food$log_sugar, na.rm = TRUE)
)
