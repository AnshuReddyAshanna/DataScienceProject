library(leaps)
subfit <- regsubsets(
log_sugar ~ gender + education + race+ timeus + numhomemeals + numsnacks + numhomemeals*numsnacks, data = df,
nvmax = 10,           # max number of predictors allowed
method = "exhaustive" # or "forward", "backward", "seqrep"
)
subsum <- summary(subfit)
# Look at criteria by subset size
subsum$adjr2   # adjusted R^2
subsum$cp      # Mallows' Cp
subsum$bic     # BIC
best_size_bic <- which.min(subsum$bic)    # or which.max(subsum$adjr2)
best_size_bic
best_coefs <- coef(subfit, best_size_bic)
best_vars  <- names(best_coefs)[-1]  # drop "(Intercept)"
best_coefs
best_r2 <- which.min(subsum$adjr2)    # or which.max(subsum$adjr2)
best_r2 <- which.max(subsum$adjr2)    # or which.max(subsum$adjr2)
best_coefs <- coef(subfit, best_r2)
best_vars  <- names(best_coefs)[-1]
best_vars
best_coefs
form_best <- as.formula(
paste("log_sugar ~", paste(best_vars, collapse = " + "))
)
subfit <- regsubsets(
log_sugar ~ ., data = df,
nvmax = 10,           # max number of predictors allowed
method = "exhaustive" # or "forward", "backward", "seqrep"
)
subsum <- summary(subfit)
subsum$adjr2   # adjusted R^2
best_r2 <- which.max(subsum$adjr2)
best_coefs <- coef(subfit, best_r2)
best_vars  <- names(best_coefs)[-1]  # drop "(Intercept)"
best_vars
food$dsugar <- as.integer(food$sugar > 50)
table(food$dsugar)
food$dsugar <- labelled(food$dsugar,
labels = c("No" = 0, "Yes" = 1))
var_label(food$dsugar) <- "High Sugar Indicator"
ggplot(food, aes(x=dsugar, y = age,fill = dsugar)) +
geom_boxplot(color = "black", alpha = 0.7) +
labs(
title = "Age Distribution by high-sugar indicator",
x = "Survival",
y = "Age"
) +
theme_minimal()
