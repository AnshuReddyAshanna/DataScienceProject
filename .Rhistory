# Libraries
library(arrow)
library(ggplot2)
library(ezids)
library(labelled)
library(gtsummary)
library(openxlsx)
library(dplyr)
library(tidyr)
library(vctrs)
library(tibble)
#Set Working Directory as the DataScienceProject folder
getwd()
#### Reading the parquet file
food <- read_parquet("proc_data/demo_foods.parquet")
setwd("~/Library/Mobile Documents/com~apple~CloudDocs/Documents/EDUCATION/GWU/GWU Courses/GWU Fall 25/Introduction to Data/ModelDataWhatWeEat")
setwd("/Users/marlon/Documents/EDUCATION/GWU/GWU Courses/GWU Fall 25/Introduction to Data Science_Darcy Morris/ModelDataWhatWeEat")
#Set Working Directory as the DataScienceProject folder
getwd()
#### Reading the parquet file
food <- read_parquet("proc_data/demo_foods.parquet")
header(food)
head(food)
food$healthy_diet = ifelse(
DR1IKCAL_sum <= 2000 &
DR1ISODI_sum < 2300 &
DR1IPROT_sum >= 50 &
DR1ISUGR_sum <= 50 &
DR1ICARB_sum <= 275 &
DR1ITFIB_sum >= 28 &
DR1ITFAT_sum <= 78,
1, 0
)
View(food)
food <- food %>%
mutate(
healthy_diet =
if_else(
DR1IKCAL_sum <= 2000 &        # Calories
DR1ISODI_sum < 2300 &         # Sodium (mg)
DR1IPROT_sum >= 50 &          # Protein (g)
DR1ISUGR_sum <= 50 &          # Sugar (g)
DR1ICARB_sum <= 275 &         # Carbs (g)
DR1IFIBE_sum >= 28 &          # Fiber (g)
DR1ITFAT_sum <= 78,           # Fat (g)
1, 0
)
)
model_data <- food %>%
select(
healthy_diet,
RIAGENDR,   # gender
RIDAGEYR,   # age
RIDRETH3,   # race (detailed)
DMDEDUC2,   # education
INDFMPIR    # income-to-poverty ratio
) %>%
drop_na()   # logistic regression cannot run with NA
model3 <- glm(
healthy_diet ~ RIAGENDR + RIDAGEYR + RIDRETH3 + DMDEDUC2 + INDFMPIR,
data = model_data,
family = binomial
)
# Create a health score (0–7) based on meeting each dietary benchmark
food = food %>%
mutate(
healthy_score =
(DR1IKCAL_sum <= 2000) +      # calories
(DR1ISODI_sum < 2300) +       # sodium
(DR1IPROT_sum >= 50) +        # protein
(DR1ISUGR_sum <= 50) +        # sugar
(DR1ICARB_sum <= 275) +       # carbohydrates
(DR1IFIBE_sum >= 28) +        # fiber
(DR1ITFAT_sum <= 78),         # fat
# Define healthy diet = 1 if they meet at least 4 of 7 criteria
healthy_diet = if_else(healthy_score >= 4, 1, 0)
)
# Create a health score (0–7) based on meeting dietary benchmark
food = food %>%
mutate(
healthy_score =
(DR1IKCAL_sum <= 2000) +      # calories
(DR1ISODI_sum < 2300) +       # sodium
(DR1IPROT_sum >= 50) +        # protein
(DR1ISUGR_sum <= 50) +        # sugar
(DR1ICARB_sum <= 275) +       # carbohydrates
(DR1IFIBE_sum >= 28) +        # fiber
(DR1ITFAT_sum <= 78),         # fat
# Define healthy diet = 1 if they meet at least 4 of 7 criteria (since all would be very rare)
healthy_diet = if_else(healthy_score >= 4, 1, 0)
)
# Convert to factor for logistic regression
food$healthy_diet = factor(food$healthy_diet)
# Select demographic predictors and drop any missing values
model_data = food %>%
select(
healthy_diet,
RIAGENDR,     # gender
RIDAGEYR,     # age
RIDRETH3,     # race/ethnicity
DMDEDUC2,     # education
INDFMPIR      # income-to-poverty ratio
) %>%
drop_na()
# Fit logistic regression predicting the odds of having a healthy diet
model3 = glm(
healthy_diet ~ RIAGENDR + RIDAGEYR + RIDRETH3 + DMDEDUC2 + INDFMPIR,
data = model_data,
family = binomial
)
# View regression results
summary(model3)
# Predicted probabilities of a healthy diet
pred_prob3 = predict(model3, type = "response")
# Convert probabilities to binary predictions using a 0.5 cutoff
pred_class3 = if_else(pred_prob3 >= 0.5, 1, 0)
# Confusion matrix comparing predictions to actual values
conf_mat3 = table(pred_class3, model_data$healthy_diet)
conf_mat3
# Model accuracy
accuracy3 = mean(pred_class3 == model_data$healthy_diet)
accuracy3
# Create a health score (0–7) based on meeting dietary benchmark
# Calculate number of criteria met
food$health_score <- with(food,
(DR1IKCAL_sum <= 2000) +
(DR1ISODI_sum <= 2300) +
(DR1IPROT_sum >= 50) +
(DR1ISUGR_sum <= 50) +
(DR1ICARB_sum <= 275) +
(DR1ITFAT_sum <= 78) +
(DR1IFIBE_sum >= 28)
)
# Healthy diet dummy (1 if at least 4 conditions met)
food$healthy_diet <- if_else(food$health_score >= 4, 1, 0)
# Count 1s and 0s
table(food$healthy_diet)
food = food %>%
mutate(
# count how many of the benchmarks each person meets
health_score =
(DR1IKCAL_sum <= 2000) +   # Calories ≤ 2000 kcal
(DR1ISODI_sum < 2300) +    # Sodium < 2300 mg
(DR1IPROT_sum >= 50) +     # Protein ≥ 50 g
(DR1ISUGR_sum <= 50) +     # Sugar ≤ 50 g
(DR1ICARB_sum <= 275) +    # Carbs ≤ 275 g
(DR1IFIBE_sum >= 28) +     # Fiber ≥ 28 g
(DR1ITFAT_sum <= 78),      # Fat ≤ 78 g
# healthy diet dummy:
# 1 = meets at least 5 of 7 criteria
healthy_diet = if_else(health_score >= 5, 1, 0)
)
# Check balance of the new healthy_diet variable
table(food$healthy_diet)
prop.table(table(food$healthy_diet))
# Marital status recode
food = food %>%
mutate(
marital_recode = case_when(
DMDMARTZ %in% c(1, 6) ~ "Partnered",
DMDMARTZ %in% c(2, 3, 4) ~ "Wid/Separated",
TRUE ~ "Single"
)
)
# Years in the U.S. recode (if variable exists)
food = food %>%
mutate(
yearsUS_recode = case_when(
DMDYRUSZ %in% c(1, 2) ~ "<4 years",
DMDYRUSZ %in% c(3, 4) ~ "5–15 years",
TRUE ~ "16+ years"
)
)
# Country of origin (US vs non-US)
food = food %>%
mutate(
origin_recode = case_when(
DMDBORN4 == 1 ~ "US",
TRUE ~ "Non-US"
)
)
names(food)
food = food %>%
mutate(
# how many of the 7 benchmarks each person meets
healthy_score =
(DR1IKCAL_sum <= 2000) +   # calories
(DR1ISODI_sum < 2300) +    # sodium
(DR1IPROT_sum >= 50) +     # protein
(DR1ISUGR_sum <= 50) +     # sugar
(DR1ICARB_sum <= 275) +    # carbs
(DR1IFIBE_sum >= 28) +     # fiber
(DR1ITFAT_sum <= 78),      # fat
# healthy_diet = 1 if they meet at least 5 of 7 criteria
healthy_diet = if_else(healthy_score >= 5, 1, 0)
)
# Check how many are classified as healthy vs not
table(food$healthy_diet)
prop.table(table(food$healthy_diet))
# Marital status: Partnered / Widowed–Separated / Single
food = food %>%
mutate(
marital_recode = case_when(
DMDMARTZ %in% c(1, 6) ~ "Partnered",
DMDMARTZ %in% c(2, 3, 4) ~ "Wid/Separated",
TRUE ~ "Single"
)
)
# Race/ethnicity RIDRETH3 into a few groups
food = food %>%
mutate(
race_recode = case_when(
RIDRETH3 %in% c(1, 2) ~ "Hispanic",
RIDRETH3 == 3 ~ "White",
RIDRETH3 == 4 ~ "Black",
TRUE ~ "Other"
)
)
# Convert categorical variables to factors
food$healthy_diet   = factor(food$healthy_diet)
food$RIAGENDR       = factor(food$RIAGENDR)       # gender
# Convert categorical variables to factors
food$healthy_diet   = factor(food$healthy_diet)
# Convert categorical variables to factors
food$healthy_diet   = factor(food$healthy_diet)
food$RIAGENDR       = factor(food$RIAGENDR)       # gender
food$race_recode    = factor(food$race_recode)
food$marital_recode = factor(food$marital_recode)
food$DMDEDUC2       = factor(food$DMDEDUC2)       # education
# Keep only variables we need for the model
model_data = food %>%
select(
healthy_diet,
RIAGENDR,        # gender
RIDAGEYR,        # age
race_recode,     # recoded race/ethnicity
marital_recode,  # recoded marital status
DMDEDUC2,        # education
INDFMPIR         # income-to-poverty ratio
) %>%
drop_na()
# Model A: only age + gender
model_A = glm(
healthy_diet ~ RIAGENDR + RIDAGEYR,
data = model_data,
family = binomial
)
# Model B: add education
model_B = glm(
healthy_diet ~ RIAGENDR + RIDAGEYR + DMDEDUC2,
data = model_data,
family = binomial
)
anova(model_A, model_B, test = "Chisq")
# Model C: add income
model_C = glm(
healthy_diet ~ RIAGENDR + RIDAGEYR + DMDEDUC2 + INDFMPIR,
data = model_data,
family = binomial
)
anova(model_B, model_C, test = "Chisq")
# Model D: add race
model_D = glm(
healthy_diet ~ RIAGENDR + RIDAGEYR + DMDEDUC2 + INDFMPIR + race_recode,
data = model_data,
family = binomial
)
anova(model_C, model_D, test = "Chisq")
# Model E: add marital status
model_E = glm(
healthy_diet ~ RIAGENDR + RIDAGEYR + DMDEDUC2 + INDFMPIR +
race_recode + marital_recode,
data = model_data,
family = binomial
)
anova(model_D, model_E, test = "Chisq")
model3 = model_E
summary(model3)
# Predicted probabilities for a healthy diet
pred_prob3 = predict(model3, type = "response")
# Turn probabilities into 0/1 using 0.5 cutoff
pred_class3 = if_else(pred_prob3 >= 0.5, 1, 0)
# Confusion matrix
conf_mat3 = table(pred_class3, model_data$healthy_diet)
conf_mat3
# Overall accuracy
accuracy3 = mean(pred_class3 == model_data$healthy_diet)
accuracy3
model3 = model_D
summary(model3)
food = food %>%
mutate(
# how many of the 7 benchmarks each person meets
healthy_score =
(DR1IKCAL_sum <= 2000) +   # calories
(DR1ISODI_sum < 2300) +    # sodium
(DR1IPROT_sum >= 50) +     # protein
(DR1ISUGR_sum <= 50) +     # sugar
(DR1ICARB_sum <= 275) +    # carbs
(DR1IFIBE_sum >= 28) +     # fiber
(DR1ITFAT_sum <= 78),      # fat
# healthy_diet = 1 if they meet at least 5 of 7 criteria
healthy_diet = if_else(healthy_score >= 7, 1, 0)
)
# Check how many are classified as healthy vs not
table(food$healthy_diet)
