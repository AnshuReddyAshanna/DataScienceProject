),
coef_label = sprintf("%.3f%s", estimate, sig),
term = factor(term, levels = rev(unique(term)))
)
ggplot(coef_df, aes(x = term, y = estimate)) +
geom_point(size = 3, color = "#4DBBD5") +
geom_errorbar(aes(ymin = conf.low, ymax = conf.high),
width = 0.2, color = "#4DBBD5") +
geom_hline(yintercept = 0, linetype = "dashed", alpha = 0.6) +
geom_text(aes(label = coef_label),
hjust = -0.1, size = 3.5) +
coord_flip() +
labs(
title = "Coefficient Plot: LM Log(Sugar Intake)",
x = NULL,
y = "Estimate (95% CI)"
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
axis.title.y = element_blank(),
panel.grid.minor = element_blank()
) +
expand_limits(y = max(coef_df$conf.high) + 0.1)
